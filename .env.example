# --- LangSmith (required for every module) ---
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
# Use a personal access token or service key (lsv2_...) with projects:create
# permission so the notebooks can register agents and deploy.
LANGSMITH_API_KEY="<langsmith-api-key>"
# Workspace ID (LangSmith Settings -> Workspace). Needed for org-scoped keys and
# for the Gateway policy demo.
LANGSMITH_WORKSPACE_ID="<workspace-id>"
WORKSPACE_ID="<workspace-id>"

# Agent-based workspaces route traces by agent + environment, set in code by the
# notebooks. Do NOT also set LANGSMITH_PROJECT: combining a project with agent
# addressing gives traces two destinations and the SDK drops them.
# LANGSMITH_PROJECT="survey-feedback-workshop"   # project-based workspaces only

# --- Models: LangSmith LLM Gateway ---
# Every model call (survey agent, ADK agent, notebook judge) goes through the
# Gateway as openai/gpt-5.6-luna, so no provider key is needed locally. Use a
# LangSmith key whose role has gateway:invoke (often the same as LANGSMITH_API_KEY).
LANGSMITH_API_KEY_GATEWAY="<langsmith-api-key>"
# Direct provider keys are only needed if you switch off the Gateway:
# OPENAI_API_KEY="<openai-api-key>"
# ANTHROPIC_API_KEY="<anthropic-api-key>"

# --- Google ADK agent (Module 6, "Bring your own agents") ---
# Defaults to the Gateway model openai/gpt-5.6-luna. Any Gateway model ID works,
# or a gemini-* name to call Gemini natively (then set GOOGLE_API_KEY or Vertex AI).
# ADK_MODEL="openai/gpt-5.6-luna"
# GOOGLE_API_KEY="<google-api-key>"
ADK_AGENT_ID="survey-feedback-adk"
ADK_AGENT_ENVIRONMENT="development"

# --- Optional: real Slack/Teams posting ---
# Incoming-webhook URL. Without it, approved posts are recorded to survey_outbox.jsonl
# in your system temp directory (override the path with SURVEY_OUTBOX).
# SURVEY_WEBHOOK_URL=""

# Azure OpenAI (optional)
# AZURE_OPENAI_API_KEY="<azure-openai-api-key>"
# AZURE_OPENAI_ENDPOINT="<azure-openai-endpoint>"
# AZURE_OPENAI_API_VERSION=""

# AWS Bedrock (optional)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION_NAME=""
# AWS_MODEL_ARN=""

# Tavily web search (legacy research agent only)
# TAVILY_API_KEY="<tavily-api-key>"
